# Rust (daemon)
/daemon/target/
**/*.rs.bk

# Go (relay)
/relay/bin/
*.test
*.out

# Generated proto code (regenerate with `make proto`)
/relay/internal/proto/
/daemon/src/gen/

# Generated Control API client (regenerate with `make gen-apiclient`).
# Deliberately not committed: nothing in the product imports it — it exists to
# prove docs/api/openapi.yaml is consumable by a real generator, which `make
# apiclient-check` does by generating, compiling, and asserting against it.
/relay/internal/apiclient/client.gen.go

# Build artifacts
/dist/
/build/

# Local secrets, certs, policy, and state — never commit
*.pem
*.key
*.crt
*.csr
/relay/*.db
/relay/*.sqlite
*.local.yaml

# Dev-loop run logs and issue drafts (transient)
/scripts/dev-loop/logs/

# Implementer's escalation marker (never merged)
/DECISION_NEEDED.md

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Relay SQLite store (default ./relay-data/relay.db) — local Node/audit state, never commit
/relay/relay-data/
**/relay-data/

# Dev-fleet host-side state exported by scripts/dev-fleet-mcp.sh: the fleet's CA
# cert and two LIVE control-plane credentials. Never commit.
/.dev-fleet/
