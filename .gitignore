# Rust (daemon)
/daemon/target/
**/*.rs.bk

# Go (relay)
/relay/bin/
*.test
*.out

# Generated proto code (regenerate with `make proto`)
/relay/internal/proto/
/daemon/src/gen/

# Build artifacts
/dist/
/build/

# Local secrets, certs, policy, and state — never commit
*.pem
*.key
*.crt
*.csr
/relay/*.db
/relay/*.sqlite
*.local.yaml

# Dev-loop run logs and issue drafts (transient)
/scripts/dev-loop/logs/

# Implementer's escalation marker (never merged)
/DECISION_NEEDED.md

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
