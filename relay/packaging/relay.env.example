# EXAMPLE EnvironmentFile for relay.service.
#
# This is a template, not a shipped config. Copy it to /etc/relay/relay.env,
# set the values you need, then:
#
#   chown root:relay /etc/relay/relay.env
#   chmod 0640 /etc/relay/relay.env
#
# WHAT THIS FILE IS, in the architecture's terms (CLAUDE.md invariant 11):
# Relay configuration is the operator's, set at startup, and NEVER reachable
# from any API. A stolen API Token cannot raise a blast cap, repoint the CA,
# move a listener, or change the OAuth issuer — no code path exists from a
# request to any value below. That is the guarantee; this file and the systemd
# unit beside it are how the guarantee is delivered on a real host.
#
# NO SECRET VALUES LIVE HERE. Every credential the Relay needs is passed as a
# FILE PATH, so nothing sensitive reaches `systemctl show`, `ps`, the journal,
# or a crash dump. Keep it that way when you add anything.
#
# Every setting also has an equivalent command-line flag (`relay --help`), and
# the environment variable WINS over the flag. Pick one and be consistent;
# mixing them is how a host ends up running something other than what its unit
# file appears to say.
#
# Values shown are the DEFAULTS unless noted. Commented-out lines are optional.

# ---------------------------------------------------------------------------
# Node plane — the mTLS gRPC listener every relay-daemon connects to
# ---------------------------------------------------------------------------

# Listen address for the Node-plane gRPC listener.
RELAY_ADDR=:7654

# Hostname placed in the server certificate's SAN. This MUST match the host
# the daemons dial (their RELAY_ADDR), or their TLS verification fails — which
# is the single most common first-run mistake.
RELAY_HOSTNAME=relay.example.internal

# ---------------------------------------------------------------------------
# State: the CA and the store
# ---------------------------------------------------------------------------

# Directory holding the Relay's CA key and certificate.
#
# THE MOST SENSITIVE PATH IN THE DEPLOYMENT. This key mints Node identities;
# whoever reads it can impersonate the Relay to the entire fleet. Under
# relay.service this lives inside StateDirectory (0700, owned by the service
# account). See docs/operations/ca-disaster-recovery.md — recovery from
# compromise is re-enrolling the fleet against a fresh CA, so the backup and
# permissions posture there is not optional reading.
RELAY_CA_DIR=/var/lib/relay/ca

# SQLite store: Jobs, Tasks, the audit trail, Accounts, API Tokens, approvals.
RELAY_STORE_PATH=/var/lib/relay/relay.db

# ---------------------------------------------------------------------------
# Blast radius (ADR-0004, ADR-0012)
# ---------------------------------------------------------------------------
#
# The maximum number of Nodes a single dispatch may touch, by risk class. This
# is a cap on the damage any one call can do — including a call from a
# compromised AI-agent — which is exactly why it is set here and is not
# settable through the Control API.
#
# Chosen by class: a read that fans out wide is a disclosure, a mutate that
# fans out wide is an outage. Raw Exec always takes the mutate cap.

#RELAY_READ_BLAST_CAP=500
#RELAY_MUTATE_BLAST_CAP=50

# Registry insert cap — an upper bound on how many Nodes may ever enroll.
# 0 disables the cap.
#RELAY_MAX_NODES=110000

# ---------------------------------------------------------------------------
# Enrollment rate limiting (ADR-0006)
# ---------------------------------------------------------------------------
#
# Enrollment is the one endpoint reachable before a Node has an identity, so it
# is the one an attacker can reach without a credential. These bound both a
# single noisy source and the aggregate.

#RELAY_ENROLL_IP_RATE=5
#RELAY_ENROLL_IP_BURST=3
#RELAY_ENROLL_GLOBAL_RATE=50
#RELAY_ENROLL_GLOBAL_BURST=10
# Cap on the per-IP bucket map, so tracking cannot itself become the memory
# exhaustion it exists to prevent.
#RELAY_ENROLL_MAX_TRACKED_IPS=100000

# ---------------------------------------------------------------------------
# Daemon version gate (ADR-0014)
# ---------------------------------------------------------------------------
#
# Minimum relay-daemon version a Node must report to be dispatched to. Empty
# means the gate is off and no Node is ever marked outdated.
#
# This is the Relay's ONLY lever over daemon versions: the Relay never pushes
# binaries and the daemon never self-upgrades. Upgrades travel through the
# customer's config management; this refuses to dispatch to what has not been
# upgraded yet.
#RELAY_MIN_DAEMON_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Control plane — MCP + /api/v1 (ADR-0009, ADR-0010)
# ---------------------------------------------------------------------------

# Off by default. Enabling it exposes the surface an AI-agent and an operator
# drive the fleet through; it is a separate listener from the Node plane above.
#RELAY_CONTROL_ENABLED=false
#RELAY_CONTROL_ADDR=:9443

# Bootstrap the first Account credential with `relay bootstrap-token` after
# first start. There is deliberately no shared-secret setting here (ADR-0023):
# the control plane authenticates per-Account API Tokens held in the store.

# ---------------------------------------------------------------------------
# OAuth (ADR-0024) — humans authenticating through an external IdP
# ---------------------------------------------------------------------------
#
# Empty issuer disables OAuth entirely, and the Relay then advertises no flow
# rather than one it cannot complete. Relay is never an authorization server.

#RELAY_OAUTH_ISSUER=https://idp.example.com
#RELAY_OAUTH_AUDIENCE=relay
# Which token claim resolves to an Account name.
#RELAY_OAUTH_ACCOUNT_CLAIM=email
#RELAY_OAUTH_REQUIRED_SCOPE=relay.operate
# This Relay's externally-reachable base URL, used to build the RFC 9728
# resource-metadata pointer a client follows. It must be the URL clients
# actually dial, not the listen address above.
#RELAY_OAUTH_PUBLIC_URL=https://relay.example.internal:9443

# ---------------------------------------------------------------------------
# Approval gates (ADR-0027)
# ---------------------------------------------------------------------------

# Path to the root-owned approval-gate rules: which dispatches must wait for a
# human. Empty means no gating.
#
# A PATH, and root-owned, for the same reason the blast caps are here: a stolen
# credential that could edit its own approval requirements would make the whole
# mechanism decorative. Note the failure mode is deliberately loud — a
# non-empty path that cannot be read REFUSES STARTUP rather than coming up with
# an empty rule set, because a Relay that silently decided nothing needs
# approval is the exact failure this exists to prevent.
#RELAY_APPROVAL_GATE_CONFIG=/etc/relay/approval-gates.json

# Where to push a Relay-authored notice that a dispatch has parked. Optional:
# with no URL nothing is pushed and approvers read the queue instead.
#
# Notification is DELIVERY, never the decision. A deployment whose webhook is
# down loses a notification, not the guarantee — decisions only ever land on
# the authenticated /api/v1 endpoint.
#RELAY_APPROVAL_WEBHOOK_URL=https://hooks.example.internal/relay-approvals

# Root-owned file holding the shared secret used to sign the outbound webhook
# body (HMAC-SHA256). A PATH, not the secret itself — a secret passed as an
# environment variable is a secret in every process listing and crash dump.
# A world-readable secret file refuses startup.
#RELAY_APPROVAL_WEBHOOK_SECRET_FILE=/etc/relay/approval-webhook.secret

#RELAY_APPROVAL_WEBHOOK_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Local operator levers (not startup configuration)
# ---------------------------------------------------------------------------

# Reason recorded when the Relay-wide Freeze is RELEASED by a local signal on
# this host (ADR-0013). Read when the signal arrives, so it can be changed
# without a restart. Engaging and releasing are both attributed and audited.
#RELAY_FREEZE_RELEASE_REASON=released locally on relay host
