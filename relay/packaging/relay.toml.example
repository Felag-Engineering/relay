# EXAMPLE configuration for the Relay: /etc/relay/relay.toml.
#
# This is a template, not a shipped config. Copy it to /etc/relay/relay.toml
# and set the values you need. The Relay reads this one file, and nothing else,
# for the settings below.
#
# WHAT THIS FILE IS, in the architecture's terms (AGENTS.md invariant 11):
# the Relay's configuration is the operator's, set outside Relay, and NEVER
# reachable from any API. A stolen API Token cannot raise a blast cap, repoint
# the CA, move a listener, or change the OAuth issuer: no code path exists from
# a request to any value below. The Relay must refuse to run if it could write
# this file, or if another account could read it (ADR-0043).
#
# Three keys are required and have no default: ca.dir, store.path and
# tls.hostname. Every other key is optional and shown commented out at its
# built-in default, or at an example value where it has none. An unknown key is
# refused, and so is a value that cannot work.
#
# A SECRET is given in the file as `key = "..."`, or as `key_file = "/path"`
# naming a file that holds it. Giving both is refused. The suffix _file is
# reserved for that; a path that is not a secret is named *_path, or dir or
# path. The approval webhook URL is a secret, because an incoming-webhook URL
# commonly carries its token in the path.
#
# Authoring rule: an optional key is written commented out as `# key = value`,
# and a prose comment never takes that shape. The drift test reads the file
# that way.

# ---------------------------------------------------------------------------
# Node plane: the mTLS gRPC listener every relay-daemon connects to
# ---------------------------------------------------------------------------
[node_plane]

# Listen address for the Node-plane gRPC listener.
# listen_address = ":7654"

# The address a join string tells a relay-daemon to dial. When unset it is
# tls.hostname on the port of listen_address. If set, its host must be
# tls.hostname: the daemons verify the server certificate against it.
# advertised_address = "relay.example.internal:7654"

# ---------------------------------------------------------------------------
# Control plane: MCP + /api/v1
# ---------------------------------------------------------------------------
[control_plane]

# Off by default. Enabling it exposes the surface an AI-agent and an operator
# drive the fleet through; it is a separate listener from the Node plane.
# enabled = false
# listen_address = ":9443"

# ---------------------------------------------------------------------------
# Admin Console
# ---------------------------------------------------------------------------
[console]

# Serve the Admin Console on the control-plane listener. Off by default, and it
# needs control_plane.enabled = true: the Console has no listener of its own,
# so it inherits that listener's internal-only exposure.
# enabled = false

# Absolute lifetime of a Console session. Activity does not extend it: a stolen
# cookie is a bounded loss rather than a permanent one.
# session_max_age = "12h"

# Idle timeout of a Console session. The two bounds answer different threats,
# idle catches the unlocked laptop and absolute the exfiltrated cookie, so
# neither substitutes for the other.
# session_idle = "30m"

# How recently a human must have re-entered their password for a
# privilege-granting Account act to proceed without being asked again. At most
# 15m: a longer value is refused. No Account of any role can extend it through
# any API. Keep it short: a window long enough to be convenient is a window
# long enough for someone else at the same keyboard.
# step_up_window = "5m"

# ---------------------------------------------------------------------------
# State: the CA and the store
# ---------------------------------------------------------------------------

# Directory holding the Relay's CA key and certificate.
#
# THE MOST SENSITIVE PATH IN THE DEPLOYMENT. This key mints Node identities;
# whoever reads it can impersonate the Relay to the entire fleet. Under
# relay.service it lives inside StateDirectory (0700, owned by the service
# account). See docs/operations/ca-disaster-recovery.md: recovery from
# compromise is re-enrolling the fleet against a fresh CA.
[ca]
dir = "/var/lib/relay/ca"

# SQLite store: Jobs, Tasks, the audit trail, Accounts, API Tokens, approvals.
[store]
path = "/var/lib/relay/relay.db"

# ---------------------------------------------------------------------------
# TLS
# ---------------------------------------------------------------------------
[tls]

# The name on the Relay's one server certificate, which both listeners present.
# A join string tells daemons to dial it. The certificate also names 127.0.0.1,
# ::1 and up to 64 of this host's addresses as they are when the Relay starts,
# so a daemon may instead dial one of this host's IPv4 addresses (RELAY_ADDRESS
# in its environment). Any other name a daemon or a browser dials must be this
# one.
hostname = "relay.example.internal"

# ---------------------------------------------------------------------------
# OAuth: humans authenticating through an external IdP
# ---------------------------------------------------------------------------
#
# Leaving out issuer disables OAuth entirely, and the Relay then advertises no
# flow rather than one it cannot complete. Relay is never an authorization
# server. Any other key in this section needs the issuer, and OAuth is served on
# the control plane.
[oauth]

# issuer = "https://idp.example.com"
# audience = "relay"
# Which token claim resolves to an Account name.
# account_claim = "email"
# required_scope = "relay.operate"
# This Relay's externally-reachable base URL, used to build the resource
# metadata pointer a client follows. It must be the URL clients actually dial,
# not the listen address.
# public_url = "https://relay.example.internal:9443"

# ---------------------------------------------------------------------------
# Approval gates
# ---------------------------------------------------------------------------
[approval]

# Path to the approval-gate rules: which dispatches must wait for a human.
# Leaving it out means no gating.
#
# A path in this file, for the same reason the blast caps are here: a stolen
# credential that could edit its own approval requirements would make the whole
# mechanism decorative. A configured path that cannot be read REFUSES STARTUP
# rather than coming up with an empty rule set, because a Relay that silently
# decided nothing needs approval is the failure this exists to prevent.
# gate_rules_path = "/etc/relay/approval-gates.json"

# Where to push a Relay-authored notice that a dispatch has parked. Optional:
# with no URL nothing is pushed and approvers read the queue instead. A secret:
# give it inline, or name a file that holds it.
#
# Notification is DELIVERY, never the decision. A deployment whose webhook is
# down loses a notification, not the guarantee: decisions only ever land on the
# authenticated /api/v1 endpoint.
# webhook_url = "https://hooks.example.internal/relay-approvals"
# webhook_url_file = "/etc/relay/approval-webhook.url"

# The shared secret that signs the outbound webhook body (HMAC-SHA256). Leaving
# it out sends unsigned notifications. A secret, in either form.
# webhook_secret = "replace-with-a-long-random-string"
# webhook_secret_file = "/etc/relay/approval-webhook.secret"

# Total time budget for one delivery attempt.
# webhook_timeout = "5s"

# ---------------------------------------------------------------------------
# Log
# ---------------------------------------------------------------------------
[log]

# One of debug, info, warn, error.
# level = "info"
# One of text, json.
# format = "text"

# ---------------------------------------------------------------------------
# Reach: how far one dispatch goes
# ---------------------------------------------------------------------------
#
# The maximum number of Nodes a single dispatch may touch, by risk class. This
# is a cap on the damage any one call can do, including a call from a
# compromised AI-agent, which is why it is set here and is not settable through
# the Control API.
#
# Chosen by class: a read that fans out wide is a disclosure, a mutate that
# fans out wide is an outage. Raw Exec always takes the mutate cap. A mutate cap
# above the read cap is accepted with a warning.
[reach]

# read_blast_cap = 10000
# mutate_blast_cap = 100

# How many Tasks of one Job run at once. This bounds how fast a Job reaches its
# Nodes, not how many it may reach.
# dispatch_concurrency = 16

# Minimum relay-daemon version a Node must report to be dispatched to. Leaving
# it out turns the gate off. This is the Relay's only lever over daemon
# versions: the Relay never pushes binaries and the daemon never self-upgrades.
# min_daemon_version = "0.1.0"

# ---------------------------------------------------------------------------
# Enrollment: rate limits, the Node cap, and certificate expiry
# ---------------------------------------------------------------------------
#
# Enrollment is the one endpoint reachable before a Node has an identity, so it
# is the one an attacker can reach without a credential. These bound both a
# single noisy source and the aggregate.
[enrollment]

# ip_rate_per_minute = 5
# ip_burst = 3
# global_rate_per_minute = 50
# global_burst = 10
# Cap on the per-IP bucket map, so tracking cannot itself become the memory
# exhaustion it exists to prevent.
# max_tracked_ips = 100000

# Registry insert cap: an upper bound on how many Nodes may ever enroll. 0
# disables the cap.
# max_nodes = 110000

# Fraction of a Node identity certificate's lifetime remaining below which
# state:cert-expiring fires. A fraction, not a duration, so it tracks any change
# to the certificate lifetime. There is no off value: it must be above 0 and at
# most 1.
# cert_expiring_fraction = 0.25
