# Hardened systemd unit for the relay-daemon (v0.0.7 groundwork).
#
# This bounds everything the daemon does NOT need; it does not — and cannot
# without breaking Operations — remove root, because service.restart commands
# PID1 via systemctl and pkg.install writes the system package database. It
# also carries a resource-containment stanza (v0.0.8 exec audit) — a
# pids-cgroup `TasksMax` fork-bomb backstop that complements the per-Task
# `setrlimit` bounds the daemon itself applies (relay-exec's `executor`) —
# and, as of #224, a v0.0.8 syscall + W^X hardening stanza (SystemCallFilter/
# SystemCallArchitectures/MemoryDenyWriteExecute).
# See docs/operations/daemon-privilege-posture.md for the per-Operation
# privilege map, the rationale behind every directive below, and the
# documented exception for Nodes running pkg.install / fs-mutating Raw Exec.
#
# Install: daemon/packaging/README.md.

[Unit]
Description=Relay relay-daemon (privileged fleet-administration Node daemon)
Documentation=file:///usr/share/doc/relay-daemon/daemon-privilege-posture.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=root
Group=root
ExecStart=/usr/bin/relay-daemon
# Optional: carries RELAY_ADDR/RELAY_DOMAIN/RELAY_CA_BUNDLE_PATH/RELAY_POLICY_PATH/
# RELAY_TEMPLATE_DIR/RELAY_NODE_LABELS/RELAY_ENROLLMENT_TOKEN. See relay-daemon.env.example. The
# leading '-' means a missing file is not a startup failure.
EnvironmentFile=-/etc/relay-daemon/relay-daemon.env
Restart=on-failure
RestartSec=5s

# Writable state: identity (key.pem/cert.pem/ca_bundle.pem/node_id) and the
# seen-tasks/ marker-file dedup store (ADR-0004). Matches the default
# RELAY_STATE_DIR of /var/lib/relay-daemon.
StateDirectory=relay-daemon
StateDirectoryMode=0700

# --- hardening (issue-required) ---
NoNewPrivileges=yes
# /usr,/etc,/boot,/var read-only; StateDirectory stays writable. Read-only
# /etc reinforces that Policy — and, since ADR-0021, the Template Operation
# files beside it — are remotely-immutable (ADR-0002): even a compromised
# daemon process cannot rewrite its own Policy or templates.
ProtectSystem=strict
# read-only (not "yes") so file.read can still reach /home,/root for its
# read-only Operation; "yes" would mask those paths and silently break reads.
ProtectHome=read-only
PrivateTmp=yes
RestrictSUIDSGID=yes
# file.read opens arbitrary Node paths (Policy constrains which, not this
# unit); CAP_DAC_READ_SEARCH grants universal read with no write/priv-bypass,
# the least privilege that keeps file.read working for non-root-owned files.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=

# --- additional restrictive directives (more-restrictive, still support the mapped Operations) ---
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
# "invisible" (not "yes"): system.facts reads /proc/sys/kernel/hostname and
# /proc/sys/kernel/osrelease, which stay visible at this level.
ProtectProc=invisible
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
# AF_NETLINK is load-bearing: system.facts enumerates interfaces via
# libc::getifaddrs, which opens an AF_NETLINK socket. AF_INET/AF_INET6 are
# the outbound mTLS connection to the Relay; AF_UNIX is load-bearing for
# service.restart: it spawns `systemctl restart <unit>`, and systemctl
# reaches PID 1 over D-Bus on an AF_UNIX socket (/run/dbus/system_bus_socket
# or /run/systemd/private). The spawned systemctl child inherits this unit's
# seccomp RestrictAddressFamilies across execve, so dropping AF_UNIX would
# silently break service.restart. Omitting any of these breaks a read
# Operation or the daemon's own connection.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# Applied by #224 from the v0.0.8 audit's derived allowlist (docs/operations/
# daemon-privilege-posture.md, "Syscall and capability surface (v0.0.8
# audit)"). @system-service is systemd's recommended base and is shared by
# BOTH profiles — the pkg-install drop-in below relaxes only ProtectSystem +
# CapabilityBoundingSet, never the syscall filter. The drop-in overrides
# MemoryDenyWriteExecute to =no for its maintainer-script interpreters (see
# the posture doc's "Documented exceptions").
# STATUS: applied by #224; offline exposure 3.7 -> 2.1; NOT YET live-verified
# on a real systemd host — the enroll->connect->execute-all-Operations trace
# remains a REQUIRED manual step (see the posture doc's Verification section).
SystemCallFilter=@system-service
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes

# --- resource containment (v0.0.8 exec audit) ---
# pids cgroup controller: hard-caps total tasks (processes + threads) in this
# service's cgroup. Defense-in-depth fork-bomb backstop. Under THIS hardened unit,
# CapabilityBoundingSet=CAP_DAC_READ_SEARCH strips CAP_SYS_RESOURCE from the daemon
# and every child (bounded at execve even for a UID-0 child, capabilities(7)), so
# RLIMIT_NPROC (set per-Task in the executor) already bounds even a root fork bomb.
# TasksMax matters for deployments run WITHOUT this cap-bounded unit (bare ExecStart,
# or the Docker dev-fleet), where a UID-0 child keeps CAP_SYS_RESOURCE and can
# bypass RLIMIT_NPROC; the pids controller is not CAP_SYS_RESOURCE-bypassable and is
# scoped to this cgroup. Sized above tokio's default thread pools (blocking-pool
# default 512 + worker threads + main) plus a heavy pkg.install process tree; see
# docs/operations/daemon-privilege-posture.md for the budget. Raise it in the
# pkg-install drop-in for packages whose maintainer scripts need more.
TasksMax=4096

[Install]
WantedBy=multi-user.target
