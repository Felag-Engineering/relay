# EXAMPLE EnvironmentFile for relay-daemon.service.
#
# This is a template, not a shipped secret. The daemon package places it as
# /etc/relay-daemon/relay-daemon.env on a first install (0600 root) and never
# rewrites it. For a hand install, copy it to
# /etc/relay-daemon/relay-daemon.env, fill in real values, then:
#
#   chown root:root /etc/relay-daemon/relay-daemon.env
#   chmod 0600 /etc/relay-daemon/relay-daemon.env
#
# RELAY_JOIN below carries a bearer secret (the Enrollment Token): install this
# file 0600 root:root, never commit a filled-in copy to version control, and
# never log its contents (the daemon itself never logs it — keep it that way in
# any tooling that generates this file).

# The join string, as minted with the Enrollment Token (relay init, the Console
# or the Control API): one value carrying the Relay address, the SHA-256
# fingerprint of the Relay's CA, and the Enrollment Token. SECRET. On first start
# the daemon pins the Relay's CA from the fingerprint before it sends the token,
# enrolls, and writes the CA bundle and the address into its state directory, so
# no CA path is configured by hand. Once enrolled it is inert and safe to remove.
# A Node with neither an identity nor a join string exits cleanly at start; a
# malformed one exits with an error. Paste the join string after the `=`, or run
# `relay-daemon join`, which replaces this line.
RELAY_JOIN=

# Optional override of the Relay's Node-plane gRPC address. The join string
# carries the address for first enrollment; the daemon persists the address it
# enrolled against and uses that on later starts. When set, this overrides it on
# every start, enrollment included - how config management repoints a Node. With
# neither, an enrolled daemon refuses to start: there is no default.
#RELAY_ADDR=https://relay.example.internal:7654

# Optional TLS SNI / server-name override, if the cert SAN differs from the
# host the daemon dials (e.g. a load-balanced or IP-addressed endpoint).
#RELAY_DOMAIN=relay.example.internal

# Path to this Node's local Policy file (root-owned, fail-closed loader;
# ADR-0002 — the Relay may query it but can never write it over the wire).
RELAY_POLICY_PATH=/etc/relay-daemon/policy.toml

# Root of this Node's Template Operation files (ADR-0021) — same root-owned
# local trust root as the Policy file, never settable over the wire. An absent
# directory simply means no templates are installed; anything unloadable leaves
# the Node with no Template Operations (fail closed). See
# docs/operations/template-packs.md.
RELAY_TEMPLATE_DIR=/etc/relay-daemon/templates.d

# Comma-separated node: labels stamped at enrollment (node-rooted, Relay-
# immutable; ADR-0006). Example: environment/role/site tags for Selectors.
#RELAY_NODE_LABELS=env=prod,role=web,site=us-east-1

# Where the daemon persists its identity (key.pem, cert.pem, ca_bundle.pem,
# node_id), the Relay address it enrolled against (relay_addr), and its
# at-most-once seen-tasks dedup markers (ADR-0004). Under
# relay-daemon.service this is the unit's StateDirectory, 0700 root:root.
#RELAY_STATE_DIR=/var/lib/relay-daemon

# Optional distinct endpoint for the one-time enrollment call, if enrollment
# is served somewhere other than the Relay address. Unset means enroll against
# RELAY_ADDR, or the join string's address when RELAY_ADDR is unset. The CA pin
# applies whichever endpoint is dialled.
#RELAY_ENROLL_ENDPOINT=https://enroll.example.internal:7654

# How often the daemon reports Facts, Policy fingerprint, and liveness to the
# Relay. Lower means the registry is fresher and Selectors target more
# accurately; higher means less chatter from a large fleet.
#RELAY_HEARTBEAT_INTERVAL_SECS=30

# How long the daemon waits on shutdown for in-flight Tasks to finish before
# exiting. This bounds how long a `systemctl stop` blocks; keep it below the
# unit's TimeoutStopSec or systemd will SIGKILL mid-Task, which turns a clean
# stop into an unresolved Task the Relay has to reconcile.
#RELAY_SHUTDOWN_GRACE_SECS=30
