# EXAMPLE EnvironmentFile for relay-daemon.service.
#
# This is a template, not a shipped secret. Copy it to
# /etc/relay-daemon/relay-daemon.env, fill in real values, then:
#
#   chown root:root /etc/relay-daemon/relay-daemon.env
#   chmod 0600 /etc/relay-daemon/relay-daemon.env
#
# This file holds no secret. It is installed 0600 root:root as defence in depth
# (the daemon's Policy keeps it from the wire); never commit a filled-in copy.
#
# The join string is never placed here. Enroll this Node with
# `sudo relay-daemon join` and paste the join string at the prompt, or pipe it on
# standard input: join pins the Relay's CA from the string's fingerprint, enrolls,
# persists the identity and the Relay address in the state directory, and starts
# the unit. RELAY_JOIN is not a setting: the daemon refuses to start while it is
# set, so a stale line from an earlier configuration is noticed rather than
# ignored. A Node with no identity exits cleanly at start.
#
# `relay-daemon join` reads this file's settings (RELAY_STATE_DIR, RELAY_ADDRESS,
# RELAY_ENROLL_ADDRESS, RELAY_SERVER_NAME, RELAY_NODE_LABELS), and refuses when
# the shell it runs in sets one of them to something else.

# Optional override of the Relay's Node-plane gRPC address. The join string
# carries the address that relay-daemon join enrolls against; the daemon persists
# it and uses that on later starts. When set, this overrides it on every start,
# enrollment included - how config management repoints a Node. With neither, an
# enrolled daemon refuses to start: there is no default.
#RELAY_ADDRESS=https://relay.example.internal:7654

# Optional: the name the daemon expects on the Relay's certificate (sent as TLS
# SNI and verified against the certificate's SAN), when it differs from the host
# the daemon dials, e.g. a load-balanced or IP-addressed endpoint.
#RELAY_SERVER_NAME=relay.example.internal

# Path to this Node's local Policy file (root-owned, fail-closed loader;
# ADR-0002 — the Relay may query it but can never write it over the wire).
# Its Policy directory (fragments composed with it) is policy.d beside it.
RELAY_POLICY_PATH=/etc/relay-daemon/policy.toml

# Root of this Node's Template Operation files (ADR-0021) — same root-owned
# local trust root as the Policy file, never settable over the wire. An absent
# directory simply means no templates are installed; anything unloadable leaves
# the Node with no Template Operations (fail closed). See
# docs/operations/template-packs.md.
RELAY_TEMPLATE_DIR=/etc/relay-daemon/templates.d

# Comma-separated node: labels stamped by relay-daemon join at enrollment
# (node-rooted, Relay-immutable; ADR-0006). Example: environment/role/site tags
# for Selectors.
#RELAY_NODE_LABELS=env=prod,role=web,site=us-east-1

# Where relay-daemon join persists the identity (key.pem, cert.pem,
# ca_bundle.pem, node_id) and the Relay address it enrolled against
# (relay_addr), and where the daemon keeps its
# at-most-once seen-tasks dedup markers (ADR-0004). Under
# relay-daemon.service this is the unit's StateDirectory, 0700 root:root.
#RELAY_STATE_DIR=/var/lib/relay-daemon

# Optional distinct endpoint for the one-time enrollment call made by
# relay-daemon join, if enrollment is served somewhere other than the Relay
# address. Unset means enroll against RELAY_ADDRESS, or the join string's address
# when RELAY_ADDRESS is unset. The CA pin applies whichever endpoint is dialled.
#RELAY_ENROLL_ADDRESS=https://enroll.example.internal:7654

# How long the daemon waits on shutdown for in-flight Tasks to finish before
# exiting. This bounds how long a `systemctl stop` blocks; keep it below the
# unit's TimeoutStopSec or systemd will SIGKILL mid-Task, which turns a clean
# stop into an unresolved Task the Relay has to reconcile.
#RELAY_SHUTDOWN_GRACE_SECS=30
