# EXAMPLE EnvironmentFile for relay-daemon.service.
#
# This is a template, not a shipped secret. Copy it to
# /etc/relay-daemon/relay-daemon.env, fill in real values, then:
#
#   chown root:root /etc/relay-daemon/relay-daemon.env
#   chmod 0600 /etc/relay-daemon/relay-daemon.env
#
# RELAY_ENROLLMENT_TOKEN below is a bearer secret: install this file 0600
# root:root, never commit a filled-in copy to version control, and never log
# its contents (the daemon itself never logs it — keep it that way in any
# tooling that generates this file).

# Address of the Relay's Node-plane gRPC listener (mTLS).
RELAY_ADDR=https://relay.example.internal:7654

# Optional TLS SNI / server-name override, if the cert SAN differs from the
# host in RELAY_ADDR (e.g. a load-balanced or IP-addressed endpoint).
#RELAY_DOMAIN=relay.example.internal

# Path to the pinned bootstrap CA bundle used to verify the Relay's cert
# during first enrollment. Not needed after a persisted identity exists.
RELAY_CA_BUNDLE_PATH=/etc/relay-daemon/ca-bundle.pem

# Path to this Node's local Policy file (root-owned, fail-closed loader;
# ADR-0002 — the Relay may query it but can never write it over the wire).
RELAY_POLICY_PATH=/etc/relay-daemon/policy.toml

# Root of this Node's Template Operation files (ADR-0021) — same root-owned
# local trust root as the Policy file, never settable over the wire. An absent
# directory simply means no templates are installed; anything unloadable leaves
# the Node with no Template Operations (fail closed). See
# docs/operations/template-packs.md.
RELAY_TEMPLATE_DIR=/etc/relay-daemon/templates.d

# Comma-separated node: labels stamped at enrollment (node-rooted, Relay-
# immutable; ADR-0006). Example: environment/role/site tags for Selectors.
#RELAY_NODE_LABELS=env=prod,role=web,site=us-east-1

# One-time Enrollment Token used on first connect to mint this Node's
# identity. SECRET — never commit, never log. Not needed once a persisted
# identity exists under the daemon's state dir (/var/lib/relay-daemon by
# default); safe to remove after first successful enrollment.
RELAY_ENROLLMENT_TOKEN=replace-with-a-real-enrollment-token
