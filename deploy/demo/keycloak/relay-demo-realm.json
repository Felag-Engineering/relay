  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 43200,
  "ssoSessionIdleTimeout": 43200,
  "ssoSessionMaxLifespan": 86400,
  "clientSessionIdleTimeout": 43200,
  "clientSessionMaxLifespan": 86400,
  "users": [
    {
      "username": "demo-user",
      "enabled": true,
      "email": "demo-user@relay-demo.invalid",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-demo-user",
          "temporary": false
        }
      ]
    },
    {
      "username": "no-relay-account",
      "enabled": true,
      "email": "no-relay-account@relay-demo.invalid",
      "emailVerified": true,
      "firstName": "DEV-ONLY negative control",
      "lastName": "deliberately has no Relay Account",
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-no-relay-account",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "relay-demo-claude-code",
